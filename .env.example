# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Each variable below is tagged:
#   [REQUIRED] the app will not start without a real value
#   [OPTIONAL] a feature degrades or is disabled without it, but the app runs
#   [UNUSED]   provisioned by an integration or left over from a past one; no
#              code reads it. Kept so the file mirrors the Vercel dashboard.

# --- Database (Neon) -------------------------------------------------------
# Get these from the Neon dashboard > your project > Connection Details.

# [REQUIRED] Validated by "/src/env.js" as a URL, so a placeholder like
# "secret" fails at startup — this one needs a real connection string.
# big garbage url no need
# POSTGRES_URL="postgresql://postgres:password@localhost:5432/HW12"
# Recommended for most uses
POSTGRES_URL=secret

# [UNUSED] For uses requiring a connection without pgbouncer
POSTGRES_URL_UNPOOLED=secret

# [UNUSED] Parameters for constructing your own connection string
PGHOST=secret
PGHOST_UNPOOLED=secret
PGUSER=secret
PGDATABASE=secret
PGPASSWORD=secret
# [UNUSED] Parameters for Vercel Postgres Templates
# (POSTGRES_URL is declared above under [REQUIRED])
POSTGRES_URL_NON_POOLING=secret
POSTGRES_USER=secret
POSTGRES_HOST=secret
POSTGRES_PASSWORD=secret
POSTGRES_DATABASE=secret
POSTGRES_URL_NO_SSL=secret
POSTGRES_PRISMA_URL=secret

# --- Auth (Clerk) ----------------------------------------------------------
# [REQUIRED] Get these from the Clerk dashboard > API Keys. `clerkMiddleware`
# in "/src/middleware.ts" throws on every request without them.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=secret
CLERK_SECRET_KEY=secret

# [UNUSED] Neon Auth (Stack) environment variables for Next.js. Superseded by
# Clerk above; no remaining references in "/src".
NEXT_PUBLIC_STACK_PROJECT_ID=secret
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=secret
STACK_SECRET_SERVER_KEY=secret

# --- Integrations ----------------------------------------------------------
# [OPTIONAL] ElevenLabs API
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# [OPTIONAL] Twilio Configuration — alerting is skipped when unset.
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
ALERT_PHONE_NUMBER=+1234567890
