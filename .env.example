# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Each variable below is tagged:
#   [REQUIRED] the app will not start without a real value
#   [OPTIONAL] a feature degrades or is disabled without it, but the app runs
#   [UNUSED]   provisioned by an integration or left over from a past one; no
#              code reads it. Kept so the file mirrors the Vercel dashboard.

# --- Database (Postgres) ---------------------------------------------------
# Any Postgres works (production runs on Railway). Paste the provider's
# connection string; include ?sslmode=require if the provider needs TLS.

# [REQUIRED] Validated by "/src/env.js" as a URL, so a placeholder like
# "secret" fails at startup — this one needs a real connection string.
# big garbage url no need
# POSTGRES_URL="postgresql://postgres:password@localhost:5432/HW12"
# Recommended for most uses
POSTGRES_URL=secret

# [UNUSED] For uses requiring a connection without pgbouncer
POSTGRES_URL_UNPOOLED=secret

# [UNUSED] Parameters for constructing your own connection string
PGHOST=secret
PGHOST_UNPOOLED=secret
PGUSER=secret
PGDATABASE=secret
PGPASSWORD=secret
# [UNUSED] Parameters for Vercel Postgres Templates
# (POSTGRES_URL is declared above under [REQUIRED])
POSTGRES_URL_NON_POOLING=secret
POSTGRES_USER=secret
POSTGRES_HOST=secret
POSTGRES_PASSWORD=secret
POSTGRES_DATABASE=secret
POSTGRES_URL_NO_SSL=secret
POSTGRES_PRISMA_URL=secret

# --- Auth (Clerk) ----------------------------------------------------------
# [REQUIRED] Get these from the Clerk dashboard > API Keys. `clerkMiddleware`
# in "/src/middleware.ts" throws on every request without them.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=secret
CLERK_SECRET_KEY=secret

# [UNUSED] Neon Auth (Stack) environment variables for Next.js. Superseded by
# Clerk above; no remaining references in "/src".
NEXT_PUBLIC_STACK_PROJECT_ID=secret
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=secret
STACK_SECRET_SERVER_KEY=secret

# --- Agent -----------------------------------------------------------------
# [REQUIRED for the agent] Shared secret the Python agent sends as
# `Authorization: Bearer …` to /api/agent/*. Until it is set those routes
# answer 503, so a public deployment never has an open ingest endpoint.
# Generate one with:  python3 -c 'import secrets; print(secrets.token_hex(24))'
# and set the same value in agent/.env.
AGENT_TOKEN=

# --- Integrations ----------------------------------------------------------
# [OPTIONAL] Voice escalation. Leave these commented out unless you have real
# credentials: the app only checks that the variables are *present*, so a
# placeholder value makes every incident attempt (and fail) a call. With all of
# them set, every ingested incident places a real phone call to
# ALERT_PHONE_NUMBER — see docs/SCRIPTS.md → Environment.
# ELEVENLABS_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=+15551234567
# ALERT_PHONE_NUMBER=+15557654321
