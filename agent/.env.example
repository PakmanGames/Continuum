# --- Control plane -----------------------------------------------------------
# From inside Docker Desktop, a `pnpm dev` on the laptop is host.docker.internal.
AGENT_BACKEND_URL=http://host.docker.internal:3000
# Must equal AGENT_TOKEN in the control plane's environment.
AGENT_TOKEN=

# --- Identity & targets ------------------------------------------------------
AGENT_NAME=agent-local
# Docker container names to watch, comma-separated.
TARGET_CONTAINERS=demo-backend,demo-frontend

# --- Diagnosis (optional) ----------------------------------------------------
# Any OpenAI-compatible endpoint. Leave LLM_API_KEY empty and the agent still
# detects, heals and reports; the explanation just says no LLM is configured.
#   OpenAI:      LLM_BASE_URL=https://api.openai.com/v1
#   Gemini:      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   Anthropic:   LLM_BASE_URL=https://api.anthropic.com/v1
#   Ollama:      LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Cap on source code sent with a diagnosis (files named in the logs first).
LLM_CONTEXT_KB=64

# --- Behaviour ---------------------------------------------------------------
# restart | none
REMEDIATION=restart
# Seconds a restarted container must stay up before the incident is resolved.
HEAL_VERIFY_S=15
POLL_S=2
HEARTBEAT_S=15
