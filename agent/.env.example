# Gemini API key — the agent diagnoses failures with Gemini. Without it the
# agent still detects, heals and reports incidents, but the explanation reads
# "diagnosis unavailable". Get one at https://aistudio.google.com/apikey
GENAI_API_KEY=

# The Continuum control plane. From inside Docker Desktop, a `pnpm dev` on the
# laptop is reachable as host.docker.internal, not localhost.
AGENT_BACKEND_URL=http://host.docker.internal:3000

# Must match AGENT_TOKEN in the control plane's environment.
AGENT_TOKEN=

# Identity of this agent instance.
AGENT_ID=1

# Containers this agent watches (Docker container names, comma-separated).
TARGET_CONTAINERS=demo-backend,demo-frontend
